<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <property name="LOG_PATH" value="D://external-bank-logs"/>
    <property name="APP_NAME" value="bank-application"/>

    <appender name="DAILY_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>
            ${LOG_PATH}/${APP_NAME}.log
        </file>

        <rollingPolicy
            class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_PATH}/${APP_NAME}-%d{yyyy-MM-dd}.log
            </fileNamePattern>

            <maxHistory>30</maxHistory>

        </rollingPolicy>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS}
                [%thread]
                %-5level
                %logger{50}
                -
                %msg%n
            </pattern>
        </encoder>

    </appender>
    
    <appender name="ERROR_FILE"
          class="ch.qos.logback.core.rolling.RollingFileAppender">

    <file>${LOG_PATH}/bank-error.log</file>

    <rollingPolicy
        class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">

        <fileNamePattern>
            ${LOG_PATH}/bank-error-%d{yyyy-MM-dd}.log
        </fileNamePattern>

        <maxHistory>30</maxHistory>

    </rollingPolicy>

    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
        <level>ERROR</level>
    </filter>

    <encoder>
        <pattern>
            %d{yyyy-MM-dd HH:mm:ss.SSS}
            [%thread]
            %-5level
            %logger{50}
            -
            %msg%n
        </pattern>
    </encoder>

</appender>

   <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="DAILY_FILE"/>
    <appender-ref ref="ERROR_FILE"/>
</root>

</configuration>